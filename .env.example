# ============================================================================
# Banco de Horas GCMI — modelo de variáveis de ambiente
# Copie para .env (que está no .gitignore) e preencha com os dados do SEU projeto.
# Project Settings > API no painel do Supabase.
#
# ATENÇÃO: a chave "service_role" NUNCA pode aparecer aqui nem no front-end.
# Ela ignora todas as políticas de RLS. Apenas a chave "anon" (pública por
# projeto, protegida pelo RLS) pode ser usada no navegador.
# ============================================================================
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Opcional — usado apenas por scripts de backend/CI, nunca pelo index.html
SUPABASE_SERVICE_ROLE_KEY=
